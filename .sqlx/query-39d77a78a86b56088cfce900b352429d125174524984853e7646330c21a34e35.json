  "query": "UPDATE context69.personal_access_tokens\nSET revoked_at = COALESCE(revoked_at, now()),\n    updated_at = now()\nWHERE id = $1\n  AND user_id = $2\nRETURNING\n    id,\n    user_id,\n    name,\n    token_hash,\n    display_prefix,\n    scopes,\n    expires_at,\n    last_used_at,\n    revoked_at,\n    created_at,\n    updated_at\n",
