  "query": "SELECT id, login_name, display_name, password_hash, is_admin, disabled_at, created_at, updated_at\nFROM context69.users\nWHERE disabled_at IS NULL\n  AND (\n    lower(login_name) LIKE $1\n    OR lower(display_name) LIKE $1\n  )\nORDER BY login_name\nLIMIT $2\n",
