{
  "db_name": "PostgreSQL",
  "query": "-- The checkpoint advances only for a repository owned by $1; the join also\n-- re-reads the authoritative group row and active generation pointer.\n--\n-- $1 group_id, $2 repository_key, $3 target_commit_sha, $4 indexed_commit_sha,\n-- $5 index_status, $6 indexed_pipeline_version, $7 indexed_config_fingerprint,\n-- $8 last_skip_summary. The identity and skip summary are only replaced when\n-- this update records a completed snapshot ($6/$7/$8 not null).\nWITH updated AS (\n    UPDATE context69.git_repository_sources\n    SET target_commit_sha = COALESCE($3, target_commit_sha),\n        indexed_commit_sha = COALESCE($4, indexed_commit_sha),\n        index_status = $5,\n        indexed_pipeline_version = COALESCE($6, indexed_pipeline_version),\n        indexed_config_fingerprint = COALESCE($7, indexed_config_fingerprint),\n        last_skip_summary = COALESCE($8, last_skip_summary),\n        last_error_code = CASE WHEN $5 = 'ready' THEN NULL ELSE last_error_code END,\n        checkpoint_updated_at = now(),\n        last_indexed_at = CASE WHEN $4 IS NULL THEN last_indexed_at ELSE now() END,\n        updated_at = now()\n    WHERE group_id = $1\n      AND repository_key = $2\n    RETURNING\n        group_id,\n        repository_key,\n        connection_key,\n        provider_kind,\n        canonical_url,\n        repository_owner,\n        repository_name,\n        default_branch,\n        target_ref,\n        target_commit_sha,\n        pinned_commit_sha,\n        indexed_commit_sha,\n        index_profile,\n        include_patterns,\n        exclude_patterns,\n        interval_seconds,\n        webhook_enabled,\n        enabled,\n        retention_count,\n        created_by_user_id,\n        config_revision,\n        refresh_dirty,\n        refresh_requested_at,\n        last_refresh_attempt_at,\n        force_rebuild_requested_at,\n        deletion_requested_at,\n        last_skip_summary,\n        indexed_pipeline_version,\n        indexed_config_fingerprint,\n        index_status,\n        last_error_code,\n        last_indexed_at,\n        checkpoint_updated_at,\n        created_at,\n        updated_at\n)\nSELECT\n    updated.group_id,\n    updated.repository_key,\n    updated.connection_key,\n    updated.provider_kind,\n    updated.canonical_url,\n    updated.repository_owner,\n    updated.repository_name,\n    updated.default_branch,\n    updated.target_ref,\n    updated.target_commit_sha,\n    updated.pinned_commit_sha,\n    updated.indexed_commit_sha,\n    updated.index_profile,\n    updated.include_patterns,\n    updated.exclude_patterns,\n    updated.interval_seconds,\n    updated.webhook_enabled,\n    updated.enabled,\n    updated.retention_count,\n    updated.created_by_user_id,\n    updated.config_revision,\n    updated.refresh_dirty,\n    updated.refresh_requested_at,\n    updated.last_refresh_attempt_at,\n    updated.force_rebuild_requested_at,\n    updated.deletion_requested_at,\n    updated.last_skip_summary,\n    updated.indexed_pipeline_version,\n    updated.indexed_config_fingerprint,\n    updated.index_status,\n    updated.last_error_code,\n    updated.last_indexed_at,\n    updated.checkpoint_updated_at,\n    updated.created_at,\n    updated.updated_at,\n    g.group_key,\n    g.full_path AS group_path,\n    g.visibility AS group_visibility,\n    ag.generation_key AS \"active_generation_key?\"\nFROM updated\nJOIN context69.groups g ON g.id = updated.group_id\nLEFT JOIN context69.git_repository_active_generations ag\n    ON ag.repository_key = updated.repository_key\n",
