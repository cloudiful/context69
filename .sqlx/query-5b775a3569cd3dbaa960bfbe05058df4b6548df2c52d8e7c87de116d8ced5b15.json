  "db_name": "PostgreSQL",
  "query": "SELECT\n    id,\n    document_id,\n    author_user_id,\n    producer,\n    result_kind,\n    schema_ref,\n    source_record_hash,\n    idempotency_key,\n    result,\n    provenance,\n    created_at\nFROM context69.document_results\nWHERE document_id = $1\n  AND ($2::text IS NULL OR producer = $2)\n  AND ($3::text IS NULL OR result_kind = $3)\n  AND ($4::bigint IS NULL OR id < $4)\nORDER BY id DESC\nLIMIT $5\n",
