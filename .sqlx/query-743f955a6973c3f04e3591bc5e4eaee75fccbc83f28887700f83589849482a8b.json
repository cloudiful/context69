  "query": "SELECT id, login_name, display_name, password_hash, is_admin, disabled_at, created_at, updated_at\nFROM context69.users\nWHERE (\n       NULLIF(BTRIM($1::TEXT), '') IS NULL\n    OR login_name ILIKE '%' || BTRIM($1::TEXT) || '%'\n    OR display_name ILIKE '%' || BTRIM($1::TEXT) || '%'\n)\nORDER BY login_name\nLIMIT $2 OFFSET $3\n",
