{
  "db_name": "PostgreSQL",
  "query": "WITH folder_scope AS (\n    SELECT group_id, project_id, visibility\n    FROM context69.library_folders\n    WHERE id = $2\n      AND project_id = $9\n),\nproject_scope AS (\n    SELECT p.group_id, p.id AS project_id, p.visibility\n    FROM context69.projects p\n    WHERE p.id = $9\n),\nresolved_scope AS (\n    SELECT group_id, project_id, visibility FROM folder_scope\n    UNION ALL\n    SELECT group_id, project_id, visibility FROM project_scope\n    LIMIT 1\n)\nINSERT INTO context69.library_files (\n    id,\n    group_id,\n    project_id,\n    visibility,\n    folder_id,\n    external_id,\n    filename,\n    media_type,\n    size_bytes,\n    sha256,\n    storage_rel_path,\n    ingest_status\n)\nSELECT\n    $1,\n    rs.group_id,\n    rs.project_id,\n    rs.visibility,\n    $2,\n    $3,\n    $4,\n    $5,\n    $6,\n    $7,\n    $8,\n    'pending'\nFROM resolved_scope rs\nRETURNING\n    group_id,\n    (SELECT group_key FROM context69.groups WHERE id = group_id) AS \"group_key!\",\n    project_id,\n    (SELECT project_key FROM context69.projects WHERE id = project_id) AS \"project_key!\",\n    visibility,\n    id,\n    folder_id,\n    external_id,\n    filename,\n    media_type,\n    size_bytes,\n    sha256,\n    storage_rel_path,\n    ingest_status,\n    error_message,\n    created_at,\n    updated_at,\n    ingested_at\n",
