{
  "db_name": "PostgreSQL",
  "query": "-- Due-order claim of cleanup intents. `FOR UPDATE SKIP LOCKED` lets workers\n-- drain the queue without blocking each other; `next_attempt_at` ordering\n-- keeps a repeatedly failing intent from starving newer work.\nSELECT id,\n       object_id,\n       group_id,\n       sha256,\n       object_key,\n       storage_backend,\n       attempts,\n       next_attempt_at,\n       last_error,\n       created_at\nFROM context69.library_storage_object_cleanup\nWHERE completed_at IS NULL\n  AND next_attempt_at <= now()\nORDER BY next_attempt_at, id\nLIMIT $1\nFOR UPDATE SKIP LOCKED\n",
