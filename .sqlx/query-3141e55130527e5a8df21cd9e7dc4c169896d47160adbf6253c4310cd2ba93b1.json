  "query": "INSERT INTO context69.library_storage_objects (\n    id,\n    group_id,\n    sha256,\n    size_bytes,\n    storage_backend,\n    object_key\n)\nVALUES ($1, $2, $3, $4, $5, $6)\nON CONFLICT (group_id, sha256) DO UPDATE\nSET size_bytes = EXCLUDED.size_bytes,\n    storage_backend = EXCLUDED.storage_backend,\n    object_key = EXCLUDED.object_key,\n    updated_at = now()\nRETURNING id, group_id, sha256, size_bytes, storage_backend, object_key\n",
