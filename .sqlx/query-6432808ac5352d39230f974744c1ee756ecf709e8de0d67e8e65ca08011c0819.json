  "db_name": "PostgreSQL",
  "query": "SELECT\n    g.repository_key,\n    g.generation_key,\n    g.generation_number,\n    g.ref_name,\n    g.commit_sha,\n    g.index_profile,\n    g.status,\n    g.file_count,\n    g.excluded_file_count,\n    g.total_bytes,\n    g.error_code,\n    g.started_at,\n    g.completed_at,\n    g.created_at,\n    g.updated_at\nFROM context69.git_repository_generations g\nJOIN context69.git_repository_sources s ON s.repository_key = g.repository_key\nWHERE s.group_id = $1\n  AND g.repository_key = $2\nORDER BY g.generation_number DESC\n",
