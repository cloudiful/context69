  "query": "SELECT\n    u.id AS \"user_id!\",\n    u.login_name,\n    u.display_name,\n    pm.role\nFROM context69.project_memberships pm\nJOIN context69.projects p ON p.id = pm.project_id\nJOIN context69.groups g ON g.id = p.group_id\nJOIN context69.users u ON u.id = pm.user_id\nWHERE g.group_key = $1\n  AND p.project_key = $2\nORDER BY u.login_name\n",
