  "query": "INSERT INTO context69.task_docling_remote_jobs (\n    task_id,\n    item_id,\n    provider,\n    remote_task_id,\n    remote_status,\n    next_poll_at,\n    deadline_at,\n    endpoint_base_url\n)\nVALUES (\n    $1,\n    $2,\n    'docling',\n    $3,\n    $4,\n    COALESCE($5, now()),\n    $6,\n    $7\n)\nRETURNING\n    id,\n    task_id,\n    item_id,\n    provider,\n    remote_task_id,\n    status,\n    remote_status,\n    attempt_count,\n    poll_step,\n    next_poll_at,\n    last_polled_at,\n    deadline_at,\n    endpoint_base_url,\n    lease_token,\n    lease_until,\n    last_error,\n    created_at,\n    updated_at,\n    finished_at,\n    dispatch_attempted,\n    submission_execution_task_id,\n    submission_generation,\n    submission_identity,\n    clock_timestamp() AS \"observed_at!\"\n",
