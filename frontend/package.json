{
  "name": "context69-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ./openapi/context69.openapi.json -o ./src/generated/openapi.ts",
    "generate:api:from-backend": "cd .. && cargo run --bin context69 -- export-openapi && cd frontend && bun run generate:api",
    "build:with-api": "bun run generate:api:from-backend && bun run build",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@primevue/forms": "^4.5.5",
    "monaco-editor": "^0.55.1",
    "openapi-fetch": "^0.13.8",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.0",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.5",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
