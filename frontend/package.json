{
  "name": "context69-frontend",
  "private": true,
  "version": "0.25.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run generate:api && bun run check && vite build",
    "preview": "vite preview",
    "generate:api": "bun install --cwd=tooling/openapi --frozen-lockfile --minimum-release-age 604800 && bun --cwd=tooling/openapi run generate",
    "generate:api:from-backend": "cd .. && cargo run --bin context69 -- export-openapi && cd frontend && bun run generate:api",
    "build:with-api": "bun run generate:api:from-backend && bun run build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "i18next": "27.0.1",
    "lucide-react": "1.70.0",
    "monaco-editor": "^0.57.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^31.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  }
}
