{
  "name": "context69-frontend",
  "private": true,
  "version": "0.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run check && vite build",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ./openapi/context69.openapi.json -o ./src/generated/openapi.ts",
    "generate:api:from-backend": "cd .. && cargo run --bin context69 -- export-openapi && cd frontend && bun run generate:api",
    "build:with-api": "bun run generate:api:from-backend && bun run build",
    "check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.133",
    "@nuxt/ui": "4.11.1",
    "monaco-editor": "^0.56.0",
    "openapi-fetch": "^0.17.0",
    "vue": "3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
